/oem.conf
!.OEM.conf.example

# Local environment / signing material
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.key
*.sig
!LICENSES/**
secrets/
*.secret

# Logs / crash dumps
*.log
/logs/
/crash-reports/

# IDE / editor
.idea/
.vscode/
*.iml
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

